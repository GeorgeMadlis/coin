# ── Operating mode ──────────────────────────────────────────────────────────────
# manual  → no LLM API calls; prompts are printed for you to paste into Claude.ai/ChatGPT
# agent   → LLM API called automatically; API keys required below
COIN_MODE=manual

# ── LLM provider (agent mode only) ─────────────────────────────────────────────
COIN_LLM_PROVIDER=anthropic          # anthropic | openai | ollama

ANTHROPIC_API_KEY=sk-ant-...
COIN_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OPENAI_API_KEY=sk-...
# COIN_OPENAI_MODEL=gpt-4o

# COIN_OLLAMA_BASE_URL=http://localhost:11434
# COIN_OLLAMA_MODEL=llama3

# ── Embeddings ──────────────────────────────────────────────────────────────────
# Ollama is free and local — good default even in agent mode
COIN_EMBED_PROVIDER=ollama
COIN_EMBED_MODEL=nomic-embed-text
# COIN_EMBED_DIM=768                 # nomic-embed-text outputs 768-dim vectors

# For OpenAI embeddings (higher quality, costs tokens):
# COIN_EMBED_PROVIDER=openai
# COIN_EMBED_MODEL=text-embedding-3-small
# COIN_EMBED_DIM=1536

# ── Storage ─────────────────────────────────────────────────────────────────────
COIN_DB_PATH=./coin.db
COIN_WIKI_DIR=./wiki
COIN_ARTIFACTS_DIR=./artifacts

# ── Web server ──────────────────────────────────────────────────────────────────
COIN_HOST=127.0.0.1
COIN_PORT=7860

# ── Ingestion ───────────────────────────────────────────────────────────────────
COIN_CHUNK_SIZE=512
COIN_CHUNK_OVERLAP=64
COIN_MAX_TOKENS_PER_DOC=32000

# ── Q&A agent ───────────────────────────────────────────────────────────────────
COIN_QA_CONFIDENCE_THRESHOLD=0.65
COIN_QA_MAX_WEB_SEARCHES=3

# ── Watch mode ──────────────────────────────────────────────────────────────────
COIN_WATCH_ENABLED=false
COIN_STALE_DAYS=90
